{
  "schemaVersion": 1,
  "id": "cloudmusic",
  "version": "${version}",

  "name": "CloudMusic",
  "description": "Use Netease Cloud Music in MC !!!",
  "authors": [
    "FengLiuFeseliud"
  ],

  "contact": {
    "homepage": "https://github.com/anjilaqwq/CloudMusic-Mod",
    "sources": "https://github.com/anjilaqwq/CloudMusic-Mod",
    "issues": "https://github.com/anjilaqwq/CloudMusic-Mod/issues"
  },

  "license": ["WTFNMFPL", "MIT"],
  "icon": "assets/cloudmusic/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [ 
      "fengliu.cloudmusic.CloudMusicClient" 
    ],
    "modmenu": [
      "fengliu.cloudmusic.compat.ModMenu"
    ]
  },

  "mixins": [
    {
      "config": "cloudmusic.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "malilib": ">=${malilib_version}"
  }
}
